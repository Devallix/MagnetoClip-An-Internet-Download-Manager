QMainWindow, QWidget#content, QDialog, QWidget#page {
    background-color: $bg;
    color: $text;
}

QFrame#sidebar {
    background-color: $surface;
    border-right: 1px solid $border;
}

QScrollArea#sidebar_nav_scroll {
    border: none;
    background: transparent;
}

QScrollArea#sidebar_nav_scroll > QWidget > QWidget#sidebar_nav {
    background: transparent;
}

QToolButton#sidebar_toggle {
    background-color: transparent;
    color: $text_muted;
    border: none;
    border-radius: 8px;
    padding: 4px;
}

QToolButton#sidebar_toggle:hover {
    background-color: $surface_alt;
    color: $text;
}

QLabel#brand {
    font-size: 20px;
    font-weight: 700;
    color: $text;
}

QLabel#brand_sub {
    font-size: 11px;
    color: $text_muted;
}

QLabel#nav_item {
    padding: 8px 12px;
    border-radius: 8px;
    color: $text_muted;
    font-size: 14px;
}

QLabel#nav_item:hover {
    background-color: $surface_alt;
    color: $text;
}

QLabel#nav_item[active="true"] {
    background-color: $accent;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#placeholder {
    font-size: 18px;
    color: $text_muted;
}

QLabel#status_network {
    color: $success;
}

QLabel#sidebar_logo {
    padding: 8px;
    background-color: transparent;
}

QLabel#page_title {
    font-size: 24px;
    font-weight: 700;
    color: $text;
}

QLabel#page_subtitle {
    font-size: 13px;
    color: $text_muted;
}

QLabel#muted {
    color: $text_muted;
}

QStatusBar {
    background-color: $surface;
    color: $text_muted;
    border-top: 1px solid $border;
}

QToolTip {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea QWidget#qt_scrollarea_viewport {
    background-color: $bg;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: $border;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QFrame#card {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}

QFrame#stat_card {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}

QLabel#stat_value {
    font-size: 26px;
    font-weight: 700;
    color: $text;
}

QLabel#stat_label {
    font-size: 12px;
    color: $text_muted;
}

QLabel#card_title {
    font-size: 15px;
    font-weight: 600;
    color: $text;
}

QLabel#card_caption {
    font-size: 12px;
    color: $text_muted;
}

QLabel#badge {
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badge[state="downloading"] {
    background-color: rgba(59, 130, 246, 0.16);
    color: $accent_blue;
}

QLabel#badge[state="paused"] {
    background-color: rgba(251, 191, 36, 0.16);
    color: $warning;
}

QLabel#badge[state="completed"] {
    background-color: rgba(52, 211, 153, 0.16);
    color: $success;
}

QLabel#badge[state="failed"] {
    background-color: rgba(248, 113, 113, 0.16);
    color: $danger;
}

QLabel#badge[state="queued"] {
    background-color: rgba(138, 146, 181, 0.16);
    color: $text_muted;
}

QPushButton {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: $border;
}

QPushButton:pressed {
    background-color: $surface;
}

QPushButton[role="accent"] {
    background-color: $accent;
    color: #FFFFFF;
    border: 1px solid $accent;
    font-weight: 600;
}

QPushButton[role="accent"]:hover {
    background-color: $accent_blue;
    border-color: $accent_blue;
}

QPushButton[role="danger"] {
    background-color: transparent;
    color: $danger;
    border: 1px solid rgba(248, 113, 113, 0.4);
}

QPushButton[role="danger"]:hover {
    background-color: rgba(248, 113, 113, 0.12);
}

QPushButton[role="ghost"] {
    background-color: transparent;
    color: $text_muted;
    border: none;
}

QPushButton[role="ghost"]:hover {
    color: $text;
    background-color: $surface_alt;
}

QPushButton:disabled {
    color: $text_muted;
    background-color: $surface;
    border-color: $border;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: $accent;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: $accent;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    selection-background-color: $accent;
    selection-color: #FFFFFF;
}

QCheckBox {
    color: $text;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid $border;
    border-radius: 4px;
    background-color: $surface;
}

QCheckBox::indicator:checked {
    background-color: $accent;
    border-color: $accent;
}

QProgressBar {
    background-color: $surface_alt;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: $accent;
    border-radius: 4px;
}

QProgressBar::chunk[state="completed"] {
    background-color: $success;
}

QProgressBar::chunk[state="failed"] {
    background-color: $danger;
}

QProgressBar::chunk[state="paused"] {
    background-color: $warning;
}

QToolButton {
    background-color: transparent;
    color: $text_muted;
    border: none;
    padding: 6px;
    border-radius: 6px;
    font-size: 13px;
}

QToolButton:hover {
    color: $text;
    background-color: $surface_alt;
}

QFrame#toolbar {
    background-color: $surface;
    border-bottom: 1px solid $border;
}

QHeaderView::section {
    background-color: $surface;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    border-right: 1px solid $border;
    padding: 8px;
    font-weight: 600;
}

QListWidget, QTableWidget, QTableView {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
}

QTableWidget::item:selected {
    background-color: $accent;
    color: #FFFFFF;
}

QLabel#about_name {
    font-size: 20px;
    font-weight: 700;
    color: $text;
}

QLabel#about_tagline {
    font-size: 12px;
    color: $text_muted;
}

QLabel#about_version {
    font-size: 13px;
    color: $accent;
    font-weight: 600;
}

QLabel#about_details {
    font-size: 12px;
    color: $text_muted;
}

QLabel#about_description {
    font-size: 12px;
    color: $text;
    max-width: 360px;
}

QLabel#about_powered {
    font-size: 12px;
    font-weight: 600;
    color: $text_muted;
}

QLabel#about_separator {
    background-color: $border;
}

/* ----- redesigned shell ----- */

QToolButton#nav_button {
    background-color: transparent;
    color: $text_muted;
    border: none;
    border-radius: 10px;
    padding: 6px 4px;
    font-size: 10px;
    font-weight: 600;
}

QToolButton#nav_button:hover {
    background-color: $surface_alt;
}

QToolButton#nav_button:checked {
    background-color: rgba(139, 92, 246, 0.16);
}

QToolButton#nav_button[tint="overview"] { color: #A78BFA; }
QToolButton#nav_button[tint="downloads"] { color: #60A5FA; }
QToolButton#nav_button[tint="completed"] { color: #34D399; }
QToolButton#nav_button[tint="analytics"] { color: #F472B6; }
QToolButton#nav_button[tint="categories"] { color: #818CF8; }
QToolButton#nav_button[tint="browser"] { color: #38BDF8; }
QToolButton#nav_button[tint="settings"] { color: #FB923C; }
QToolButton#nav_button[tint="about"] { color: #E879F9; }

QToolButton#tool_button {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 10px;
    font-weight: 600;
}

QToolButton#tool_button:hover {
    background-color: $border;
}

QToolButton#tool_button[tint="add"] { color: $success; }
QToolButton#tool_button[tint="start"] { color: $accent_blue; }
QToolButton#tool_button[tint="pause"] { color: $warning; }
QToolButton#tool_button[tint="remove"] { color: $danger; }
QToolButton#tool_button[tint="upload"] { color: $accent_cyan; }

QToolButton#tool_button[role="danger"]:hover {
    background-color: rgba(248, 113, 113, 0.12);
}

QToolButton#tool_button:disabled {
    color: $text_muted;
    background-color: transparent;
    border-color: $border;
}

QFrame#category_button {
    background-color: transparent;
    border-radius: 10px;
    padding: 2px;
}

QFrame#category_button:hover {
    background-color: $surface_alt;
}

QFrame#category_button[active="true"] {
    background-color: $accent;
}

QFrame#category_button[active="true"] QLabel {
    color: #FFFFFF;
}

QLabel#category_name {
    font-size: 13px;
    font-weight: 600;
    color: $text;
}

QLabel#category_count {
    background-color: $surface;
    color: $text_muted;
    border: 1px solid $border;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 6px;
    min-width: 20px;
    text-align: center;
}

QFrame#category_button[active="true"] QLabel#category_count {
    background-color: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
    border: none;
}

QLabel#counter_badge {
    background-color: $accent;
    color: #FFFFFF;
    border-radius: 14px;
    font-size: 12px;
    font-weight: 700;
}

QFrame#category_button[active="true"] QLabel#counter_badge {
    background-color: rgba(255, 255, 255, 0.22);
}

QLabel#sidebar_all_title {
    font-size: 14px;
    font-weight: 700;
    color: $text;
}

QTableWidget#downloads_table, QTableWidget#schedules_table {
    background-color: $surface;
    alternate-background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 12px;
    gridline-color: transparent;
}

QTableWidget#downloads_table::item, QTableWidget#schedules_table::item {
    padding: 6px;
    border: none;
    border-bottom: 1px solid $border;
}

QTableWidget#downloads_table::item:hover, QTableWidget#schedules_table::item:hover {
    background-color: rgba(139, 92, 246, 0.12);
}

QTableWidget#downloads_table::item:selected, QTableWidget#schedules_table::item:selected {
    background-color: rgba(139, 92, 246, 0.18);
    color: $text;
}

QTableWidget#downloads_table::indicator, QTableWidget#schedules_table::indicator {
    width: 16px;
    height: 16px;
}

QTableWidget#downloads_table::indicator:unchecked, QTableWidget#schedules_table::indicator:unchecked {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 4px;
}

QTableWidget#downloads_table::indicator:checked, QTableWidget#schedules_table::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
    border-radius: 4px;
}

QProgressBar#status_bar {
    background-color: $surface_alt;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#status_bar::chunk {
    border-radius: 4px;
}

QProgressBar#status_bar::chunk[state="downloading"] {
    background-color: $success;
}

QProgressBar#status_bar::chunk[state="paused"] {
    background-color: $warning;
}

QLabel#status_percent {
    font-size: 12px;
    color: $text_muted;
}

QLabel#status_percent[state="finished"] {
    color: $success;
    font-weight: 600;
}

QLabel#status_percent[state="failed"] {
    color: $danger;
    font-weight: 600;
}

QLabel#save_feedback {
    color: $success;
    font-size: 13px;
    font-weight: 600;
}

QDialog#details_dialog {
    background-color: $bg;
}

QLabel#detail_label {
    font-size: 13px;
    font-weight: 600;
    color: $text_muted;
}

QLabel#detail_value {
    font-size: 13px;
    color: $text;
}

QFrame#overview_action {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 12px;
    padding: 14px 16px;
}

QFrame#overview_action:hover {
    background-color: $surface_alt;
    border-color: $accent;
}

QLabel#overview_action_title {
    font-size: 13px;
    font-weight: 600;
    color: $text;
}

QLabel#overview_action_hint {
    font-size: 12px;
    color: $text_muted;
}

QLabel#overview_empty {
    font-size: 14px;
    color: $text_muted;
    padding: 24px;
}
