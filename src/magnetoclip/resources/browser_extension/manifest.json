{
  "manifest_version": 3,
  "name": "MagnetoClip Companion",
  "version": "1.2.0",
  "description": "Captures downloads, adds a right-click download menu, and detects downloadable files for MagnetoClip.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "notifications",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MagnetoClip Companion",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "magneto-companion@magnetoclip.app",
      "strict_min_version": "115.0"
    }
  }
}
